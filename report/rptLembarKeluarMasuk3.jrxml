	<parameter name="finger" class="java.lang.String"/>
	<parameter name="finger2" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT

    reg_periksa.no_rawat,
    pasien.no_rkm_medis,
    pasien.nm_pasien,
    pasien.tmp_lahir,
    pasien.tgl_lahir,
    reg_periksa.umurdaftar,
    reg_periksa.sttsumur,
    pasien.jk,
    pasien.agama,
    pasien.pnd,
    pasien.pekerjaan,
    pasien.no_tlp,
    pasien.stts_nikah,
    kelurahan.nm_kel,
    kecamatan.nm_kec,
    pasien.alamatpj,
    pasien.pekerjaanpj,
    pasien.kelurahanpj,
    pasien.kecamatanpj,
    
    -- Tgl Masuk berdasarkan waktu masuk bangsal (kamar_inap)
    kamar_inap.tgl_masuk,
    kamar_inap.jam_masuk,
    DATE_FORMAT(kamar_inap.tgl_masuk, '%d') AS tgl_reg_dd,
    DATE_FORMAT(kamar_inap.tgl_masuk, '%m') AS tgl_reg_mm,
    DATE_FORMAT(kamar_inap.tgl_masuk, '%Y') AS tgl_reg_yyyy,
    TIME_FORMAT(kamar_inap.jam_masuk, '%H:%i:%s') AS jam_reg_str,
    
    -- Tgl Keluar berdasarkan kamar_inap
    kamar_inap.tgl_keluar,
    kamar_inap.jam_keluar,
    DATE_FORMAT(kamar_inap.tgl_keluar, '%d') AS tgl_kel_dd,
    DATE_FORMAT(kamar_inap.tgl_keluar, '%m') AS tgl_kel_mm,
    DATE_FORMAT(kamar_inap.tgl_keluar, '%Y') AS tgl_kel_yyyy,
    TIME_FORMAT(kamar_inap.jam_keluar, '%H:%i:%s') AS jam_kel_str,
    
    kamar_inap.diagnosa_awal,
    kamar_inap.diagnosa_akhir,
    kamar_inap.stts_pulang,
    penjab.png_jawab,
    
    catatan_masuk_keluar.masuk_melalui,
    catatan_masuk_keluar.cara_masuk,
    catatan_masuk_keluar.kd_dokter_konsultan,
    dokter_kons.nm_dokter AS nm_dokter_konsultan,
    dokter_menerima.nm_dokter AS nm_dokter_menerima,
    catatan_masuk_keluar.nama_tindakan_operasi,
    catatan_masuk_keluar.jenis_anastesi,
    catatan_masuk_keluar.golongan_operasi,
    catatan_masuk_keluar.infeksi_nosokomial,
    catatan_masuk_keluar.penyebab_infeksi,
    catatan_masuk_keluar.pemeriksaan_fisik,
    catatan_masuk_keluar.hasil_usg,
    catatan_masuk_keluar.hasil_ekg,
    catatan_masuk_keluar.hasil_rontgen,
    catatan_masuk_keluar.hasil_lab,
    catatan_masuk_keluar.imunisasi_masuk,
    catatan_masuk_keluar.imunisasi_rawat,
    catatan_masuk_keluar.transfusi_darah_cc,
    catatan_masuk_keluar.rujukan_dari,
    catatan_masuk_keluar.alamat_perujuk,
    catatan_masuk_keluar.tempat_tugas_perujuk,
    catatan_masuk_keluar.telp_perujuk,
    catatan_masuk_keluar.cara_rujukan,
    catatan_masuk_keluar.catatan_rujukan,
    catatan_masuk_keluar.keadaan_pulang,
    catatan_masuk_keluar.ket_keadaan_pulang,
    catatan_masuk_keluar.cara_pulang,
    catatan_masuk_keluar.ket_cara_pulang,
    catatan_masuk_keluar.catatan,
    
    -- Info Penanggung Jawab Pasien
    IFNULL(surat_persetujuan_umum.nama_pj, reg_periksa.p_jawab) AS nama_pj,
    IFNULL(surat_persetujuan_umum.umur_pj, '-') AS umur_pj
    
FROM catatan_masuk_keluar
INNER JOIN reg_periksa ON catatan_masuk_keluar.no_rawat = reg_periksa.no_rawat
INNER JOIN pasien ON reg_periksa.no_rkm_medis = pasien.no_rkm_medis
LEFT JOIN kelurahan ON pasien.kd_kel = kelurahan.kd_kel
LEFT JOIN kecamatan ON pasien.kd_kec = kecamatan.kd_kec
INNER JOIN kamar_inap ON reg_periksa.no_rawat = kamar_inap.no_rawat
INNER JOIN penjab ON reg_periksa.kd_pj = penjab.kd_pj
LEFT JOIN dokter AS dokter_menerima ON reg_periksa.kd_dokter = dokter_menerima.kd_dokter
LEFT JOIN dokter AS dokter_kons ON catatan_masuk_keluar.kd_dokter_konsultan = dokter_kons.kd_dokter
LEFT JOIN surat_persetujuan_umum ON surat_persetujuan_umum.no_rawat = reg_periksa.no_rawat
WHERE catatan_masuk_keluar.no_rawat = $P{no_rawat}
GROUP BY catatan_masuk_keluar.no_rawat]]>
	</queryString>
