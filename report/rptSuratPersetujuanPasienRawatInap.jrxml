				<text><![CDATA[PERATURAN- PERATURAN RUMAH SAKIT]]></text>
			</staticText>
			<line>
				<reportElement x="0" y="106" width="545" height="1" uuid="5a5fae43-c57b-4d08-b565-8a1adbe1a118"/>
				<graphicElement>
