				</textElement>
				<text><![CDATA[1.]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement x="30" y="657" width="512" height="20" uuid="64fdbc01-ee55-4c9e-8d15-210f4d9038c1"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{izin_akses_rs} + " Rumah Sakit memberikan akses bagi : keluarga dan handaitaulan serta orang-orang yang ingin mengetahui saya berobat / tidak di Rumah Sakit."]]></textFieldExpression>
			</textField>
